#include <stdio.h>

int main() {
    int a[] = {1, 3, 8};
    int b[] = {2, 7, 10, 11};
    int m = 3, n = 4;

    int i = 0, j = 0, count = 0;
    int prev = 0, curr = 0;

    while (count <= (m + n) / 2) {
        prev = curr;

        if (i < m && (j >= n || a[i] < b[j]))
            curr = a[i++];
        else
            curr = b[j++];

        count++;
    }

    if ((m + n) % 2 == 0)
        printf("Median: %.2f", (prev + curr) / 2.0);
    else
        printf("Median: %d", curr);

    return 0;
}
