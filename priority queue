#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX 200005

typedef struct {
    int id;
    int urgency;
} Artifact;

Artifact heap[MAX];
int size = 0;

int ids[MAX];
int withdrawn[MAX];
int restored[MAX];
int idCount = 0;

int higher(Artifact a, Artifact b) {
    if (a.urgency != b.urgency)
        return a.urgency > b.urgency;
    return a.id < b.id;
}

void push(Artifact x) {
    int i = ++size;

    while (i > 1 && higher(x, heap[i / 2])) {
        heap[i] = heap[i / 2];
        i /= 2;
    }

    heap[i] = x;
}

Artifact pop() {
    Artifact top = heap[1];
    Artifact last = heap[size--];

    int i = 1, child;

    while (i * 2 <= size) {
        child = i * 2;

        if (child + 1 <= size &&
            higher(heap[child + 1], heap[child]))
            child++;

        if (higher(last, heap[child]))
            break;

        heap[i] = heap[child];
        i = child;
    }

    if (size > 0)
        heap[i] = last;

    return top;
}

int findId(int id) {
    for (int i = 0; i < idCount; i++) {
        if (ids[i] == id)
            return i;
    }
    return -1;
}

int main() {
    int M;
    scanf("%d", &M);

    char event[20];

    for (int i = 0; i < M; i++) {
        scanf("%s", event);

        if (strcmp(event, "ARRIVE") == 0) {
            int id, urgency;
            scanf("%d %d", &id, &urgency);

            ids[idCount] = id;
            withdrawn[idCount] = 0;
            restored[idCount] = 0;
            idCount++;

            Artifact a = {id, urgency};
            push(a);
        }
        else if (strcmp(event, "WITHDRAW") == 0) {
            int id;
            scanf("%d", &id);

            int index = findId(id);
            if (index != -1)
                withdrawn[index] = 1;
        }
        else if (strcmp(event, "RESTORE") == 0) {
            while (size > 0) {
                Artifact top = heap[1];
                int index = findId(top.id);

                if (index != -1 &&
                    !withdrawn[index] &&
                    !restored[index])
                    break;

                pop();
            }

            if (size == 0) {
                printf("IDLE\n");
            } else {
                Artifact a = pop();
                int index = findId(a.id);

                restored[index] = 1;
                printf("%d\n", a.id);
            }
        }
    }

    return 0;
}
