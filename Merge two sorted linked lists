#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *next;
};

struct Node *merge(struct Node *a, struct Node *b) {
    struct Node dummy = {0, NULL};
    struct Node *tail = &dummy;

    while (a && b) {
        if (a->data <= b->data) {
            tail->next = a;
            a = a->next;
        } else {
            tail->next = b;
            b = b->next;
        }
        tail = tail->next;
    }

    tail->next = a ? a : b;
    return dummy.next;
}

int main() {
    struct Node c = {5, NULL};
    struct Node b = {3, &c};
    struct Node a = {1, &b};

    struct Node f = {6, NULL};
    struct Node e = {4, &f};
    struct Node d = {2, &e};

    struct Node *head = merge(&a, &d);

    while (head) {
        printf("%d ", head->data);
        head = head->next;
    }

    return 0;
}
