#include <stdio.h>
#include <stdlib.h>

typedef struct {
    long long profit;
    long long deadline;
} Job;

int *parent;

int find(int x) {
    if (parent[x] == x)
        return x;
    return parent[x] = find(parent[x]);
}

int compare(const void *a, const void *b) {
    Job *j1 = (Job *)a;
    Job *j2 = (Job *)b;

    if (j1->profit < j2->profit)
        return 1;
    if (j1->profit > j2->profit)
        return -1;

    return 0;
}

int main() {
    int n;
    scanf("%d", &n);

    Job *jobs = (Job *)malloc(n * sizeof(Job));
    parent = (int *)malloc((n + 1) * sizeof(int));

    for (int i = 0; i < n; i++) {
        scanf("%lld %lld", &jobs[i].profit, &jobs[i].deadline);
    }

    for (int i = 0; i <= n; i++) {
        parent[i] = i;
    }

    qsort(jobs, n, sizeof(Job), compare);

    long long totalProfit = 0;
    int accepted = 0;

    for (int i = 0; i < n; i++) {
        int deadline;

        if (jobs[i].deadline > n)
            deadline = n;
        else
            deadline = (int)jobs[i].deadline;

        int slot = find(deadline);

        if (slot > 0) {
            totalProfit += jobs[i].profit;
            accepted++;

            parent[slot] = find(slot - 1);
        }
    }

    printf("%lld %d\n", totalProfit, accepted);

    free(jobs);
    free(parent);

    return 0;
}
