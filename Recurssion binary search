#include <stdio.h>

int search(int a[], int low, int high, int key) {
    if (low > high)
        return -1;

    int mid = low + (high - low) / 2;

    if (a[mid] == key)
        return mid;

    if (key < a[mid])
        return search(a, low, mid - 1, key);

    return search(a, mid + 1, high, key);
}

int main() {
    int a[] = {2, 5, 8, 12, 16, 23};
    int n = sizeof(a) / sizeof(a[0]);

    printf("Index: %d", search(a, 0, n - 1, 12));
    return 0;
}
