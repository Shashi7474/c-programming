#include <stdio.h>

int main() {
    int a[] = {1, 2, 3};
    int n = 3;
    int result = 0;

    for (int i = 0; i < n; i++) {
        for (int j = i; j < n; j++) {
            int x = 0;

            for (int k = i; k <= j; k++)
                x ^= a[k];

            result ^= x;
        }
    }

    printf("XOR of all subarrays: %d", result);
    return 0;
}
