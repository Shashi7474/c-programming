#include <stdio.h>

#define SIZE 3

int keys[SIZE], values[SIZE], age[SIZE];
int clockValue = 0;

void put(int key, int value) {
    int pos = -1;

    for (int i = 0; i < SIZE; i++)
        if (keys[i] == key)
            pos = i;

    if (pos == -1) {
        pos = 0;

        for (int i = 0; i < SIZE; i++) {
            if (keys[i] == -1) {
                pos = i;
                break;
            }

            if (age[i] < age[pos])
                pos = i;
        }
    }

    keys[pos] = key;
    values[pos] = value;
    age[pos] = ++clockValue;
}

int get(int key) {
    for (int i = 0; i < SIZE; i++) {
        if (keys[i] == key) {
            age[i] = ++clockValue;
            return values[i];
        }
    }

    return -1;
}

int main() {
    for (int i = 0; i < SIZE; i++)
        keys[i] = -1;

    put(1, 100);
    put(2, 200);
    put(3, 300);

    printf("%d\n", get(1));

    put(4, 400);

    printf("%d\n", get(2));

    return 0;
}
