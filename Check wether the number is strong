#include <stdio.h>

int fact(int n) {
    int f = 1;
    for (int i = 2; i <= n; i++)
        f *= i;
    return f;
}

int main() {
    int n, temp, sum = 0;
    scanf("%d", &n);
    temp = n;

    do {
        sum += fact(temp % 10);
        temp /= 10;
    } while (temp > 0);

    printf("%s", sum == n ? "Strong" : "Not Strong");
    return 0;
}
