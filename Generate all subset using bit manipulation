#include <stdio.h>

int main() {
    int a[] = {1, 2, 3};
    int n = 3;

    for (int mask = 0; mask < (1 << n); mask++) {
        printf("{ ");

        for (int j = 0; j < n; j++) {
            if (mask & (1 << j))
                printf("%d ", a[j]);
        }

        printf("}\n");
    }

    return 0;
}
