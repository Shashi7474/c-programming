#include <stdio.h>
#include <string.h>

int main() {
    char s[] = "babad";
    int n = strlen(s);

    int start = 0, maxLen = 1;

    for (int i = 0; i < n; i++) {
        for (int type = 0; type < 2; type++) {
            int left = i;
            int right = i + type;

            while (left >= 0 && right < n &&
                   s[left] == s[right]) {
                if (right - left + 1 > maxLen) {
                    start = left;
                    maxLen = right - left + 1;
                }

                left--;
                right++;
            }
        }
    }

    printf("Longest palindrome: ");

    for (int i = start; i < start + maxLen; i++)
        printf("%c", s[i]);

    return 0;
}
