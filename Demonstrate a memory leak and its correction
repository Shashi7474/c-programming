#include <stdio.h>
#include <stdlib.h>

int main() {
    int *ptr = malloc(5 * sizeof(int));

    if (ptr == NULL)
        return 1;

    for (int i = 0; i < 5; i++)
        ptr[i] = (i + 1) * 10;

    for (int i = 0; i < 5; i++)
        printf("%d ", ptr[i]);

    free(ptr);
    ptr = NULL;

    return 0;
}
